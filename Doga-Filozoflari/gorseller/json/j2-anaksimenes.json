m_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":2400,"thumbheight":2950,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/d/de/Apostel_Paulus%2C_RP-P-2012-52.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":2400,"height":2950},"url":"https://upload.wikimedia.org/wikipedia/commons/d/de/Apostel_Paulus%2C_RP-P-2012-52.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Apostel_Paulus,_RP-P-2012-52.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=84661386","extmetadata":{"DateTime":{"value":"2023-07-25 21:31:54","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Apostel Paulus, RP-P-2012-52","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"CC-Zero|Images with color correction charts from the Rijksmuseum Amsterdam|Engravings of religion in the Rijksmuseum Amsterdam|The Illustrated Bartsch 42|Engravings of apostles in the Rijksmuseum Amsterdam","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<br><br><big><b>Identificatie</b></big><br><b>Titel(s): </b>Apostel Paulus<br><b>Objecttype:</b> prent <br><b>Objectnummer:</b> RP-P-2012-52<br><b>Catalogusreferentie:</b> The Illustrated Bartsch 42-2(2). Robert-Dumesnil 35-2(?). Bartsch 42-2(2)<br><b>Opschriften / Merken:</b> verzamelaarsmerk, verso, gestempeld: Lugt 2760; verzamelaarsmerk, verso, gestempeld: Lugt 2228<br><b>Omschrijving:</b> Apostel Paulus ten voeten uit, staand. Met zijn rechterhand houdt hij een boek vast dat hij leest, met zijn linkerhand zijn zwaard, dat op de grond rust.<br><br><big><b>Vervaardiging</b></big><br><b>Vervaardiger:</b> prentmaker: Nicolas Beatrizet (vermeld op object), naar eigen ontwerp van: Nicolas Beatrizet, uitgever: Nicolas Beatrizet (vermeld op object)<br><b>Plaats vervaardiging:</b> Itali\u00eb<br><b>Datering:</b> 1525 - 1566<br><b>Fysieke kenmerken:</b> gravure<br><b>Materiaal:</b> papier <br><b>Techniek:</b> graveren (drukproced\u00e9)<br><b>Afmetingen:</b> plaatrand: h 388 mm \u00d7 b 309 mm<br><br><big><b>Toelichting</b></big><br>De inscriptie met de naam van de apostel midden onder vervangt een eerder opschrift, waarin de man werd geduid als de antieke filosoof en astronoom Anaximenes. De verandering van de Griekse filosoof in de apostel kreeg verder gestalte door de toevoeging van het zwaard.<br><br><big><b>Onderwerp</b></big><br><b>Wat: </b>the apostle Paul of Tarsus; possible attributes: book, scroll, sword<br><br><big><b>Verwerving en rechten</b></big><br><b>Credit line:</b> Aankoop uit het F.G. Waller-Fonds<br><b>Verwerving:</b> aankoop 13-apr-2012<br><b>Copyright:</b> Publiek domein","source":"commons-desc-page"},"DateTimeOriginal":{"value":"between 1525 and 1566<div style=\"display: none;\">date QS:P,+1550-00-00T00:00:00Z/7,P1319,+1525-00-00T00:00:00Z/9,P1326,+1566-00-00T00:00:00Z/9</div>","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"http://hdl.handle.net/10934/RM0001.collect.512093\">http://hdl.handle.net/10934/RM0001.collect.512093</a>","source":"commons-desc-page"},"Artist":{"value":"Rijksmuseum","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Zero, Public Domain Dedication","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"Lic