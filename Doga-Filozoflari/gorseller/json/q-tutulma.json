dden":""},"Categories":{"value":"Solar eclipse of 2017 August 21 in the United States|NOIRLab Images|NOIRLab files uploaded by OptimusPrimeBot","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The Sun\u2019s corona shining brightly during a total solar eclipse.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"4 June 2019 (upload date)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://noirlab.edu/public/images/noirlab1902a\">The Sun\u2019s corona shining brightly during a total solar eclipse.</a>","source":"commons-desc-page"},"Artist":{"value":"2009 Miloslav Druckm\u00fcller, Peter Aniol, Vojtech Ru\u0161in, \u013dubom\u00edr Klocok, Karel Marti\u0161ek, Martin Dietzel","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"Attribution":{"value":"NOIRLab","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-4.0","source":"commons-templates","hidden":""}},"mime":"image/tiff"}]},"74328931":{"pageid":74328931,"ns":6,"title":"File:Total Solar Eclipse 8-21-17.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":4226214,"width":4236,"height":5648,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Total_Solar_Eclipse_8-21-17.jpg/3840px-Total_Solar_Eclipse_8-21-17.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":2400,"thumbheight":3200,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Total_Solar_Eclipse_8-21-17.jpg/3840px-Total_Solar_Eclipse_8-21-17.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":2400,"height":3200},"url":"https://upload.wikimedia.org/wikipedia/commons/c/cd/Total_Solar_Eclipse_8-21-17.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Total_Solar_Eclipse_8-21-17.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=74328931","extmetadata":{"DateTime":{"value":"2018-11-11 23:20:42","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Total Solar Eclipse 8-21-17","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Canon EOS 5D Mark IV|Solar corona|Featured pictures of Wyoming|New moon|Earthshine|Self-published work|Featured pictures on Wikipedia, English|Items with VRTS permission confirmed|Picture of week on the Czech Wikipedia|Featured pictures on Wikipedia, Persian|Featured pictures on Wikipedia, Spanish|Files with coordinates missing SDC location of creation|General category images from Wiki Science Competition 2017|Solar eclipse of 2017 August 21 in Wyoming|Images from Wiki Science Competition 2017 in the United States|National finalists for the General category from Wiki Science Competition 2017|General category images from Wiki Science Competition 2017 in the United States|Uploaded via Campaign:wsc-us|Featured pictures of solar eclipses|Featured pictures on Wikipedia, Arabic|Pictures of the Year/2018 (finalist)|Featured pictures by others nominated by Rhododendrites|Featured pictures from Wiki Science Competition 2017|Astronomical composite images","source":"commons-categories","hidden":""},"Assessments":{"value":"quality|featured|poty|potd","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"43.383333","source":"commons-desc-page"},"GPSLongitude":{"value":"-109.166667","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"Total solar eclipse image taken through Takahashi FS152 with a f6 focal reducer and a Canon 5D MarkIV, exposure bracketing was used in seven steps from 1/2 sec to 1/8000 sec.  Image was processed in Photomatix 6 and Photoshop CC 2017.  \n<p>In this image there is a huge range of luminosities between the corona near the sun and the earthshine-illuminated moon, and the only way to make such a picture is by combining the seven different images into a single image. Seven exposures spanning a 4000:1 range of exposures were taken within 2 seconds of each other on a tracking telescope with identical orientation. Such process is called <a href=\"https://en.wikipedia.org/wiki/high-dynamic-range_imaging\" class=\"extiw\" title=\"w:high-dynamic-range imaging\">high-dynamic-range imaging</a>. The picture is a combination of 7 pictures taken from 1/8000 sec to \u00bd sec within 1 second. The software takes the dim part of the image from the longer exposures and the brightest parts from the shortest exposure. \n</p>\n<p>\nThis image is a correction to the lead image on the web page which shows the moon illuminated by earthshine but is inverted due to an error in the post processing of the image. See <a href=\"//commons.wikimedia.org/wiki/File_talk:Total_Solar_Eclipse_8-21-17.jpg\" title=\"File talk:Total Solar Eclipse 8-21-17.jpg\">the talk page</a>. The mistake was made when combining the images using both an automated process using Photomatix and then manually in Photoshop. When adding in the \u00bd second image in Photoshop to capture the moon detail it was inverted by mistake. There is no issue of the images being taken in different orientations: a link to <a rel=\"nofollow\" class=\"external text\" href=\"http://astrogab.ning.com/photo/solar-eclipse-2017-half-second-raw-exposure?context=user\">the raw \u00bd second image</a> that was used is below and it can be compared to the <a rel=\"nofollow\" class=\"external text\" href=\"http://astrogab.ning.com/photo/solar-eclipse-2017-jackson-hole-wy?context=user\">composite image</a>. The correct moon orientation is clearly apparent in the \u00bd second image.</p>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2017-08-20","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Msadler13\" title=\"User:Msadler13\">Michael S Adler</a>","source":"commons-desc-page"},"Permission":{"value":"<p><span class=\"layouttemplateargs\" style=\"display:none;speak:none;\" title=\"template=PermissionTicket 1%3Dhttps%3A%2F%2Fticket.wikimedia.org%2Fotrs%2Findex.pl%3FAction%3DAgentTicketZoom%26TicketNumber%3D2017121910000697 2%3D2017121910000697\">\u00a0</span>\n</p>\n<style data-mw-deduplicate=\"TemplateStyles:r1254222110\">.mw-parser-output .messagebox{margin:4px 0;width:auto;border-collapse:collapse;border:2px solid var(--border-color-progressive,#6485d1);background-color:var(--background-color-neutral-subtle,#fbfcff);color:var(--color-base,#202122);box-sizing:border-box;border-inline-start-width:8px}.mw-parser-output .messagebox.mbox-small{font-size:88%;line-height:1.25em}.mw-parser-output .mbox-warning,.mw-parser-output .mbox-speedy{border:2px solid var(--border-color-error,#b22222);background:var(--background-color-error-subtle,#ffdbdb);border-inline-start-width:8px}.mw-parser-output .mbox-serious,.mw-parser-output .mbox-delete,.mw-parser-output .mbox-stop{border:2px solid var(--border-color-error,#b22222);border-inline-start-width:8px}.mw-parser-output .mbox-issue,.mw-parser-output .mbox-content{border:2px solid #f28500;background:var(--background-color-warning-subtle,#ffe);border-inline-start-width:8px}.mw-parser-output .mbox-query