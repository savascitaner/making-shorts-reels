lue":"2020-10-15 03:22:40","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Lorentz force on charged particles in bubble chamber - HD.6D.635 (12000265314)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Magnetic fields|Lorentz force|Self-published work|Bubble chamber particle tracks","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Photograph of liquid hydrogen bubble chamber tracks of charged particles. The magnetic field points downward. Positively and negatively charged particles spiral in opposite directions.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-10-14","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Ponor\" title=\"User:Ponor\">Ponor</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}},"mime":"image/svg+xml"}]},"18664596":{"pageid":18664596,"ns":6,"title":"File:Neutrino bubble chamber decay overlay.png","index":2,"imagerepository":"local","imageinfo":[{"size":658784,"width":902,"height":748,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/e/e4/Neutrino_bubble_chamber_decay_overlay.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":2400,"thumbheight":1990,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/e/e4/Neutrino_bubble_chamber_decay_overlay.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":2400,"height":1990},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e4/Neutrino_bubble_chamber_decay_overlay.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Neutrino_bubble_chamber_decay_overlay.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=18664596","extmetadata":{"DateTime":{"value":"2012-03-11 16:30:31","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Neutrino bubble chamber decay overlay","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Retouched pictures|Zero Gradient Synchrotron|PD US DOE|Derivative versions|Uploaded with derivativeFX|Bubble chamber particle tracks|Neutrinos","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>The world's first neutrino observation in a hydrogen bubble chamber was found Nov. 13, 1970, on this historical photograph from the Zero Gradient Synchrotron's 12-foot bubble chamber. The invisible neutrino strikes a proton where three particle tracks originate (right). The neutrino turns into a muon, the long center track. The short track is the proton. The third track is a pi-meson created by the collision. This picture is rotated to the original photograph and includes a colored overlay which shows the visible and invisble tracks of the decay. Also the weak neutrino decay is shown on the right hand side. From: <a href=\"//commons.wikimedia.org/w/index.php?title=Argonne_National_Laboratory&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Argonne National Laboratory (page does not exist)\">Argonne National Laboratory</a>, <a rel=\"nofollow\" class=\"external free\" href=\"http://www.anl.gov/Science_and_Technology/History/Anniversary_Frontiers/86photo.html\">http://www.anl.gov/Science_and_Technology/History/Anniversary_Frontiers/86photo.html</a>\n</p>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"//commons.wikimedia.org/wiki/File:FirstNeutrinoEventAnnotated.jpg\" class=\"mw-file-description\" title=\"Annotated version\"><img alt=\"Annotated version\" src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/FirstNeutrinoEventAnnotated.jpg/120px-FirstNeutrinoEventAnnotated.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"90\" class=\"mw-file-element\" srcset=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/FirstNeutrinoEventAnnotated.jpg/250px-FirstNeutrinoEventAnnotated.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"675\" data-file-height=\"506\"></a></span></div>\n\t\t\t<div class=\"gallerytext\">Annotated version </div>\n\t\t</li>\n</ul>  ==","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2012-03-11 16:26","source":"commons-desc-page"},"Credit":{"value":"This file was derived from:  <a href=\"//commons.wikimedia.org/wiki/File:First_neutrino_observation.jpg\" title=\"File:First neutrino observation.jpg\">First neutrino observation.jpg</a>:\u00a0<span typeof=\"mw:File\"><a href=\"//commons.wikimedia.org/wiki/File:First_neutrino_observation.jpg\" class=\"mw-file-description\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/First_neutrino_observation.jpg/60px-First_neutrino_observation.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"39\" class=\"mw-file-element\" srcset=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/First_neutrino_observation.jpg/120px-First_neutrino_observation.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"432\" data-file-height=\"336\"></a></span><br>","source":"commons-desc-page"},"Artist":{"value":"<ul><li><a href=\"//commons.wikimedia.org/wiki/File:First_neutrino_observation.jpg\" title=\"File:First neutrino observation.jpg\">First_neutrino_observation.jpg</a>:\u00a0?</li>\n<li>derivative work:Messier</li></ul>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/png"}]},"84493300":{"pageid":84493300,"ns":6,"title":"File:Openstax college-physics 22.19 bubble-chamber.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":164022,"width":439,"height":416,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/b/b6/Openstax_college-physics_22.19_bubble-chamber.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":2400,"thumbheight":2274,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/b/b6/Openstax_college-physics_22.19_bubble-chamber.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":2400,"height":2274},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b6/Openstax_college-physics_2